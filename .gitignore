# Dependencies — also covered by subdir gitignores, defensive root pass
node_modules/
**/node_modules/
.pnp.*

# Environment files — NEVER commit. Subdir .gitignores also cover this.
.env
.env.*
!.env.example
!**/.env.example

# Build artefacts
.next/
**/.next/
dist/
**/dist/
build/
**/build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# Test artefacts
test-results/
playwright-report/
.playwright-mcp/

# User uploads in dev (real uploads go to Cloudinary in prod)
backend/uploads/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Root-level design / smoke / tour screenshots
# These are dev scratch — keep them locally but out of the repo
/*.png
/*.jpg
/*.jpeg
/*.gif

# Vercel / deploy
.vercel/
