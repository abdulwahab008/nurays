# Things we don't want sent to the docker daemon as build context.
# Keep this tight — fewer bytes means faster builds + smaller images.

node_modules
dist
build

# Local env / secrets — runtime configures these via env vars
.env
.env.*
!.env.example

# Tests + dev tooling
tests
coverage
.nyc_output
*.test.ts
*.spec.ts
jest.config.*
nodemon.json

# Logs and OS junk
logs
*.log
.DS_Store

# Local uploads never go into the image: in production they live in object storage
# (STORAGE_DRIVER=s3) or on the persistent volume mounted at /app/uploads.
uploads

# Documentation / status files at this directory level
*.md
docs

# Git
.git
.gitignore
