# Database
DATABASE_URL=postgresql://username:password@localhost:5432/frozennuray_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-key-change-in-production

# Server
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:3000

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Choose ONE of the following email configurations:

# Option 1: Gmail (Recommended for development)
# -------------------------------------------
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Use that App Password below (not your regular Gmail password)
#
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-gmail-app-password
# EMAIL_FROM=FrozenNuray <your-email@gmail.com>

# Option 2: Custom SMTP Server
# -------------------------------------------
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# EMAIL_FROM=FrozenNuray <noreply@yourdomain.com>

# Option 3: SendGrid
# -------------------------------------------
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# EMAIL_FROM=FrozenNuray <noreply@yourdomain.com>

# Option 4: No configuration (Development only)
# -------------------------------------------
# If no email config is provided, emails will be sent to Ethereal
# (a fake SMTP service for testing). Check the console for the
# preview URL to view sent emails.

# Google OAuth (Optional)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# SMS / OTP (Twilio) – for login OTP to phone
# ============================================
# If not set, OTP is only logged to the server console (dev).
# Get credentials at https://console.twilio.com
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# PAYMENT GATEWAYS (JazzCash, EasyPaisa, Bank)
# ============================================
# See docs/PAYMENT_GATEWAY_INTEGRATION.md for setup.

# JazzCash (https://payments.jazzcash.com.pk)
# JAZZCASH_MERCHANT_ID=your-merchant-id
# JAZZCASH_PASSWORD=your-merchant-password
# JAZZCASH_RETURN_URL=https://yourdomain.com/orders/payment-return
# JAZZCASH_CANCEL_URL=https://yourdomain.com/checkout?cancel=1
# JAZZCASH_SANDBOX=true

# EasyPaisa (https://easypay.easypaisa.com.pk)
# EASYPAISA_STORE_ID=your-store-id
# EASYPAISA_API_KEY=your-api-key
# EASYPAISA_RETURN_URL=https://yourdomain.com/orders/payment-return
# EASYPAISA_SANDBOX=true

# Bank / IBFT (via your bank or aggregator)
# BANK_API_URL=https://api.bank-or-aggregator.com
# BANK_MERCHANT_ID=your-merchant-id
# BANK_API_KEY=your-api-key
# BANK_RETURN_URL=https://yourdomain.com/orders/payment-return
