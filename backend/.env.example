# Nuray backend configuration.
#
# The server checks this at startup (src/config/env.ts). In production it refuses
# to start, listing every problem, when something required is missing or unsafe.
# Only NODE_ENV=development or test relax anything; any other value (or none)
# runs with production rules.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_VERSION=v1

# --- Database & Redis --------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/frozennuray_dev
# Required in production. Lets several app instances act as one: shared rate limits,
# live updates that reach clients on any instance, and a durable background job queue
# (emails, notifications). Optional in development: without it each runs in this process.
REDIS_URL=redis://localhost:6379

# --- Auth --------------------------------------------------------------------
# At least 32 characters. Generate one with: openssl rand -hex 32
# The sample below is refused in production.
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d
# Google sign-in (optional). Must match the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# --- URLs --------------------------------------------------------------------
# The website. Used in email links; must be https:// in production.
FRONTEND_URL=http://localhost:3000
# Browser origin allowed to call the API (defaults to http://localhost:3000).
CORS_ORIGIN=http://localhost:3000
# Public URL of this API server (used to build some absolute links).
BASE_URL=http://localhost:3001

# --- Email (required in production) -------------------------------------------
# Either SMTP (any provider: Amazon SES, Mailgun, Zoho, your host's SMTP)...
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# ...or Gmail with an App Password (https://myaccount.google.com/apppasswords):
# EMAIL_SERVICE=gmail
# EMAIL_USER=you@gmail.com
# EMAIL_PASSWORD=your-app-password
EMAIL_FROM=Nuray <noreply@yourdomain.pk>
# Development without email settings uses a throwaway Ethereal inbox.

# --- SMS / phone OTP (required in production unless SMS_PROVIDER=none) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# twilio | console (development only: prints codes here) | none (no phone OTP)
# Leave empty to pick automatically (twilio when configured, else console in development).
SMS_PROVIDER=

# --- File storage --------------------------------------------------------------
# local: this server's disk (development, or one server with a persistent volume)
# s3:    any S3-compatible store: AWS S3, Cloudflare R2, Backblaze B2, MinIO
STORAGE_DRIVER=local
# local driver: where files are kept. In production this must be a persistent,
# backed-up volume (the Docker image uses /app/uploads).
UPLOADS_DIR=
# s3 driver:
S3_BUCKET=
# Private files (payment receipts, documents, chat media). Must NOT be publicly
# readable. Defaults to S3_BUCKET; if you share one bucket, only allow public
# reads of keys starting with "p/".
S3_PRIVATE_BUCKET=
S3_REGION=auto
# For R2 / MinIO / B2: the S3 API endpoint, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL images are served from: your CDN, or the bucket's public URL.
# Required for s3; optional for local (put a CDN in front of /media).
ASSET_BASE_URL=
# Signs private file links for the local driver (defaults to a value derived from JWT_SECRET).
FILE_URL_SECRET=

# --- Online payments: Safepay (optional) --------------------------------------
SAFEPAY_PUBLIC_KEY=
SAFEPAY_SECRET_KEY=
# Must be set explicitly in production when the keys above are set: false = live.
SAFEPAY_SANDBOX=true

# --- Bank payment aggregator (optional, placeholder contract) --------------------
BANK_API_URL=
BANK_MERCHANT_ID=
BANK_API_KEY=
BANK_RETURN_URL=

# --- Order timeouts (background sweep, every 2 minutes) ---------------------------
# Not accepted by the kitchen within this many minutes: cancelled (stock back, refund).
ORDER_ACCEPT_TIMEOUT_MINUTES=30
# Paid online / by transfer but never completed within this many minutes: cancelled.
ORDER_PAYMENT_TIMEOUT_MINUTES=60
# A reported transfer the kitchen hasn't confirmed after this many hours: admins alerted.
PAYMENT_CONFIRM_ESCALATE_HOURS=6

# --- Logs & error tracking ------------------------------------------------------
# Logs are JSON lines in production (one per event, with the request id) and readable
# lines in development. trace | debug | info | warn | error
LOG_LEVEL=info
# Set to json to get JSON lines in development too.
LOG_FORMAT=
# Sentry (or a Sentry-compatible service such as GlitchTip): unexpected errors are reported
# with the request id and user id; no request bodies, cookies or headers. Off when empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# --- Shutdown (SIGTERM / SIGINT) -------------------------------------------------
# Readiness (/api/v1/health/ready) answers 503 for this long before the server stops
# accepting connections, so a load balancer drains it first. Default 5000 in production.
SHUTDOWN_DRAIN_MS=
# Hard limit for the whole shutdown (finishing requests and jobs) before a forced exit.
SHUTDOWN_GRACE_MS=25000
