{
  "name": "frozen-nuray-backend",
  "version": "1.0.0",
  "description": "Nuray backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:baseline": "ts-node scripts/db-baseline.ts",
    "db:check": "prisma migrate diff --from-url \"$DATABASE_URL\" --to-schema-datamodel prisma/schema.prisma --exit-code",
    "prisma:studio": "prisma studio",
    "seed:e2e": "ts-node prisma/seed-e2e.ts",
    "api-checks": "ts-node scripts/api-checks/run-all.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --max-warnings 110",
    "lint:fix": "eslint src --fix",
    "load:seed": "ts-node scripts/load/seed-load.ts",
    "load:tokens": "ts-node scripts/load/mint-tokens.ts",
    "load:run": "ts-node scripts/load/run.ts"
  },
  "keywords": [
    "frozen-food",
    "marketplace",
    "pakistan"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.12.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.4",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@prisma/client": "^6.19.0",
    "@sentry/node": "^11.2.0",
    "@smithy/node-http-handler": "^4.12.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/compression": "^1.8.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.11",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.13",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.0",
    "rate-limit-redis": "^6.0.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "twilio": "^5.3.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  }
}
