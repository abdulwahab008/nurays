# Nuray web app configuration. Copy to .env.local for development.
#
# NEXT_PUBLIC_* values are baked into the JavaScript at build time, so changing
# them means rebuilding (Docker: pass them as build args, see Dockerfile).

# The backend API, including /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# The realtime (Socket.IO) server. Leave empty when it is the API's origin.
NEXT_PUBLIC_WS_URL=
# Google sign-in (optional). Must match the backend's GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Shows the one-click demo accounts in a production build. Never on a real site.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# Company details on the Terms, Privacy and Refund pages. Until they are set the
# pages show bracketed placeholders. Set NEXT_PUBLIC_LEGAL_REVIEWED=true once a
# lawyer has reviewed the text, to remove the "draft" notice.
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_REVIEWED=false

# Server-side only: identifies the app to OpenStreetMap's geocoder (their usage
# policy asks for a contact), e.g. "Nuray/1.0 (support@yourdomain.pk)".
NOMINATIM_USER_AGENT=
