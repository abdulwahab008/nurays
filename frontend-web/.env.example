# Nuray web app configuration. Copy to .env.local for development.
#
# NEXT_PUBLIC_* values are baked into the JavaScript at build time, so changing
# them means rebuilding (Docker: pass them as build args, see Dockerfile).

# The backend API, including /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# The realtime (Socket.IO) server. Leave empty when it is the API's origin.
NEXT_PUBLIC_WS_URL=
# Google sign-in (optional). Must match the backend's GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Shows the one-click demo accounts in a production build. Never on a real site.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
# Browser error tracking (Sentry or compatible). Off when empty; nothing is loaded then.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=

# Build time. false (default): the Content-Security-Policy is report-only, violations are logged by
# /api/csp-report. true: it is enforced. Switch after a week of clean reports.
CSP_ENFORCE=false

# Company details on the Terms, Privacy and Refund pages. Until they are set the
# pages show bracketed placeholders. Set NEXT_PUBLIC_LEGAL_REVIEWED=true once a
# lawyer has reviewed the text, to remove the "draft" notice.
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_REVIEWED=false

# Server-side only: identifies the app to OpenStreetMap's geocoder (their usage
# policy asks for a contact), e.g. "Nuray/1.0 (support@yourdomain.pk)".
NOMINATIM_USER_AGENT=
# Geocoder base URL (default: public Nominatim, 1 request/second, cached). Use your own or a paid geocoder in production.
NOMINATIM_BASE_URL=
# A paid geocoder's account key, and the query parameter it travels in (default "key"). Server-side only.
NOMINATIM_API_KEY=
NOMINATIM_API_KEY_PARAM=
# Pause between calls to the geocoder in milliseconds (default 1100, the public server's limit; 0 for none),
# and how many lookups may wait their turn before the next is told to retry (default 20).
NOMINATIM_MIN_INTERVAL_MS=
NOMINATIM_MAX_PENDING=
# Lookups one address may make a minute (default 120). Many users share one mobile-network address: keep it generous.
GEOCODE_PER_IP_PER_MINUTE=
# Map tiles (default: public OpenStreetMap, development/light use only). Set a tile provider you have an account with for production.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
